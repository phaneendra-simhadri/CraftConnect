# Copy to .env and fill in. Leave OPENAI_API_KEY blank to run with the offline mock.
OPENAI_API_KEY=
# Optional: point at any OpenAI-compatible endpoint.
# Groq example (free, with voice):
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_MODEL=qwen/qwen3.8-27b
#   OPENAI_TRANSCRIBE_MODEL=whisper-large-v3
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Optional: Groq API key for fast, free Whisper voice transcription.
# When set, voice notes are transcribed with Groq regardless of the chat provider
# (useful when the chat provider is OpenRouter/DeepSeek, which do not transcribe audio).
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TRANSCRIBE_MODEL=whisper-large-v3

# Force the deterministic offline mock even if a key is present.
USE_MOCK_LLM=false

# Twilio WhatsApp sandbox (optional, only for the real WhatsApp channel).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Public base URL used to build buyer links (e.g. your ngrok URL).
# Leave blank when running `python app.py --live` - the tunnel fills it in automatically.
PUBLIC_BASE_URL=

# ngrok authtoken (free) so `python app.py --live` can create the public tunnel.
NGROK_AUTHTOKEN=
